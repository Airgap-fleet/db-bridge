# airgap-db-bridge configuration
# Copy to .env (never commit .env). Canonical prefix: DB_BRIDGE_*
# Legacy POSTGRES_* and POSTGRESQL_MCP_* are used only when the
# matching DB_BRIDGE_* variable is unset.

# PostgreSQL connection string (required for database tools)
# Format: postgresql://user:password@host:port/database
DB_BRIDGE_DSN=postgresql://postgres:postgres@localhost:5432/postgres

# Connection pool size (1-100, default: 10)
DB_BRIDGE_POOL_SIZE=10

# Read-only flag on the config object (true/false, default: false)
DB_BRIDGE_READ_ONLY=false

# Query timeout in seconds (0.1-300, default: 30)
DB_BRIDGE_QUERY_TIMEOUT=30.0

# Log level (DEBUG, INFO, WARNING, ERROR). Logs go to stderr only.
DB_BRIDGE_LOG_LEVEL=INFO
