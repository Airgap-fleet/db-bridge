# PostgreSQL MCP Server Configuration
# Copy this file to .env and customize for your environment

# PostgreSQL Connection String (required)
# Format: postgresql://user:password@host:port/database
POSTGRESQL_MCP_DSN=postgresql://postgres:postgres@localhost:5432/postgres

# Connection Pool Size (1-100, default: 10)
POSTGRESQL_MCP_POOL_SIZE=10

# Read-Only Mode (true/false, default: false)
# When true, blocks execute() and run_migration() tools
POSTGRESQL_MCP_READ_ONLY=false

# Query Timeout in seconds (0.1-300, default: 30)
POSTGRESQL_MCP_QUERY_TIMEOUT=30.0

# Log Level (DEBUG, INFO, WARNING, ERROR, default: INFO)
POSTGRESQL_MCP_LOG_LEVEL=INFO