# Filesystem MCP Server Configuration
# Copy this file to .env and customize for your environment
# All values can also be set as environment variables directly

# ==============================================================================
# REQUIRED: Root directory for all filesystem operations (sandbox)
# All paths are resolved relative to this directory for security.
# Never set to "/" or a system directory in production!
# ==============================================================================
FILESYSTEM_MCP_ROOT_PATH=/path/to/your/sandbox

# ==============================================================================
# OPTIONAL: File size limits (bytes)
# ==============================================================================
# Maximum file size for read/write operations (default: 10MB)
FILESYSTEM_MCP_MAX_FILE_SIZE=10485760

# ==============================================================================
# OPTIONAL: Security settings
# ==============================================================================
# Allow following symlinks (default: false)
# WARNING: Setting to true can allow escape from sandbox
FILESYSTEM_MCP_FOLLOW_SYMLINKS=false

# Allow absolute paths (default: false)
# When true, absolute paths are resolved directly instead of relative to root
# WARNING: Can bypass sandbox if not careful
FILESYSTEM_MCP_ALLOW_ABSOLUTE_PATHS=false

# ==============================================================================
# OPTIONAL: Encoding
# ==============================================================================
# Default text encoding for read/write (default: utf-8)
FILESYSTEM_MCP_DEFAULT_ENCODING=utf-8

# ==============================================================================
# EXAMPLE PROFILES (uncomment one)
# ==============================================================================

# Development: Current project directory
# FILESYSTEM_MCP_ROOT_PATH=.

# Project-specific: Your project workspace
# FILESYSTEM_MCP_ROOT_PATH=/home/user/projects/my-app

# Read-only system config (use with caution)
# FILESYSTEM_MCP_ROOT_PATH=/etc
# FILESYSTEM_MCP_ALLOW_ABSOLUTE_PATHS=true
# FILESYSTEM_MCP_MAX_FILE_SIZE=1048576

# Large file support (e.g., for data processing)
# FILESYSTEM_MCP_MAX_FILE_SIZE=104857600  # 100MB